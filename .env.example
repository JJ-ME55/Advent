# ADVENT keeper settings. Copy to .env (git-ignored). Keys live in keys/*.json (git-ignored), never here.
RPC_URL=https://api.mainnet-beta.solana.com,https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=YOUR_HELIUS_KEY
MINT=
TREASURY_KEYPAIR=keys/treasury.json
DOOR_KEYPAIR=keys/door.json
BONUS_KEYPAIR=keys/bonus.json
XMAS_WALLET=
TEAM_WALLET=
# the pump.fun bonding curve and the PumpSwap pool for the mint, plus any team wallets; the keeper adds its own wallets
EXCLUDE=
DRAWS_DIR=draws
STATE_FILE=state/keeper-state.json
BONUS_ENTRANTS_FILE=state/bonus-entrants.json
# settled results in full (private; the API reads them) and the opens/claims the API records (the keeper reads them)
RESULTS_DIR=state/results
CLAIMS_FILE=state/claims.json
# seconds after a door opens during which its prizes can be claimed; blank = no deadline (rule not decided yet)
CLAIM_DEADLINE_SECONDS=
# the village: a long random secret picks each day's coin spots (generated and kept in the state file if blank)
VILLAGE_SECRET=
VILLAGE_STATE_FILE=state/village.json
VILLAGE_LAYOUT_FILE=
VILLAGE_FIRST_DOOR=1
TICK_SECONDS=20
CLAIM_MIN_SOL=0.05
RESERVE_SOL=0.02
FLOOR_SOL=0.1
DOOR_HOUR_UTC=18
FIRST_DOOR=1
LAST_DOOR=25
ALERT_WEBHOOK=
# the API (claims need DOOR_KEYPAIR and BONUS_KEYPAIR above)
PORT=8787
SITE_ORIGIN=https://advent.lol
# the poster: dry-run writes to posts/ until the X keys are in and DRY_RUN=0
DRY_RUN=1
SITE_URL=https://advent.lol
TICKER=$ADVENT
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
